{
  "name": "yucli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.0",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "bin": {
    "yucli": "dist/bootstrap/cli.js"
  },
  "scripts": {
    "dev": "tsx src/bootstrap/cli.ts",
    "start": "node dist/bootstrap/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
